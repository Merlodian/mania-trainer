<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>FsBeatmapProcessor</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <!-- Build against the same FSharp.Core that osu-trainer.csproj ships (8.0.100). Without this,
       newer .NET SDKs compile against their own FSharp.Core and the app fails to load the
       beatmap parser at runtime. -->
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="8.0.100" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="JunUtils.fs" />

    <Compile Include="General.fs" />
    <Compile Include="Editor.fs" />
    <Compile Include="Metadata.fs" />
    <Compile Include="Difficulty.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="TimingPoints.fs" />
    <Compile Include="Colours.fs" />
    <Compile Include="HitObjects.fs" />

    <Compile Include="BeatmapProcessor.fs" />
    <Compile Include="Program.fs" />
    <Compile Include="FsBeatmap.fs" />
  </ItemGroup>

</Project>
